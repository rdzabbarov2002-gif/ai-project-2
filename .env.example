# Copy to .env.local (git-ignored) and fill in. On Vercel, set the same
# variables in Project Settings → Environment Variables.

# --- Required ---------------------------------------------------------------

# Supabase project (Settings → API). The service-role key is server-only —
# never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — the AI Provider Gateway's Claude provider
# (lib/ai-provider/claude.ts): generation and company-profile autofill.
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------

# Overrides the auto-detected origin used for email-confirmation redirect
# links. Leave unset for local dev and Vercel preview deploys —
# lib/site-url.ts falls back to the request's own host. Set explicitly in
# production if you sit behind a proxy that mangles Host/X-Forwarded-* headers.
NEXT_PUBLIC_SITE_URL=

# Default provider/model used by the AI Provider Gateway (these are the
# defaults when unset).
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-sonnet-5

# Free generations a guest gets before being asked to register (default 3,
# architecture doc §8), and the per-user/per-guest burst limit on
# /api/generate in generations per minute (default 6).
GUEST_GENERATION_LIMIT=
MAX_GENERATIONS_PER_MINUTE=

# Other providers are typed stubs today (see lib/ai-provider/) — these keys
# are not read by anything yet; they're reserved for when each is connected.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
