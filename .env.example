# Copy to .env.local (git-ignored) and fill in. On Vercel, set the same
# variables in Project Settings → Environment Variables (Production: the
# prod Supabase project, Preview: staging — see README.md).
#
# The server checks these at startup (lib/env.ts) and refuses to start if a
# required one is missing or malformed. A blank line means "not set".

# --- Required ---------------------------------------------------------------

# Supabase project (Settings → API), or for the local stack the API_URL,
# ANON_KEY and SERVICE_ROLE_KEY from `npx supabase status -o env`. The
# service-role key is server-only — never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — the AI Provider Gateway's Claude provider
# (lib/ai-provider/claude.ts): generation and company-profile autofill.
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------

# Overrides the auto-detected origin used for email-confirmation redirect
# links. Leave unset for local dev and Vercel preview deploys —
# lib/site-url.ts falls back to the request's own host. Set explicitly in
# production if you sit behind a proxy that mangles Host/X-Forwarded-* headers.
NEXT_PUBLIC_SITE_URL=

# Default provider/model used by the AI Provider Gateway (these are the
# defaults when unset).
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-sonnet-5

# Free generations a guest gets before being asked to register (default 3,
# architecture doc §8), and the per-user/per-guest burst limit on
# /api/generate in generations per minute (default 6).
GUEST_GENERATION_LIMIT=
MAX_GENERATIONS_PER_MINUTE=

# Sentry error tracking (lib/sentry.ts). Off when the DSN is unset — fine
# for local development. NEXT_PUBLIC_: compiled into the browser code at
# build time, so set it before deploying.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only (Vercel): upload source maps to Sentry so stack traces
# show the original code. Without them no source maps are produced.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics (lib/analytics.ts): a few funnel events sent from the
# server to PostHog — no cookies, nothing in the browser. Off when the key
# is unset. The host defaults to PostHog's US cloud; for an EU project set
# https://eu.i.posthog.com.
POSTHOG_KEY=
POSTHOG_HOST=

# Payments (Stripe, docs/billing.md). Off when STRIPE_SECRET_KEY is unset:
# the upgrade buttons say so and the webhook refuses. With it set, the
# webhook's signing secret is required too. CRON_SECRET protects the
# nightly subscription check (Vercel sends it to the cron route).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# Other providers are typed stubs today (see lib/ai-provider/) — these keys
# are not read by anything yet; they're reserved for when each is connected.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
