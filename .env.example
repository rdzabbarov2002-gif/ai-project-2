# Supabase (Stage 2: Auth wired up; tables still arrive in Stage 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: overrides the auto-detected origin used for email-confirmation
# redirect links. Leave unset for local dev and Vercel preview deploys —
# lib/site-url.ts falls back to the request's own host. Set explicitly in
# production if you sit behind a proxy that mangles Host/X-Forwarded-* headers.
NEXT_PUBLIC_SITE_URL=

# AI Providers — filled in as each is connected (Claude first, Stage 4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Default provider/model used by the AI Provider Gateway
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-sonnet-5
